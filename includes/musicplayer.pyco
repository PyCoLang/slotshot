"""
musicplayer.pyco - Common music driver for PyCo

This is the shared Furnace music player driver.
Include this ONCE in your program, then include song files.

Based on furC64 by AArt1256, converted for PyCo.

USAGE:
    include("musicplayer")     # Include driver ONCE
    include("title_music")     # Title song data
    include("ingame_music")    # In-game song data

    def main():
        title_music_init()       # Switch to title song
        # ...
        ingame_music_init()      # Switch to in-game song

LOOP CONTROL:
    # Play a song only once (no repeat):
    effect_music_init()
    music_disable_loop()         # Disable looping

    # Check if one-shot song ended:
    if music_is_ended():
        # Song finished playing
        ...

    # Re-enable looping for next song:
    music_enable_loop()

CHANNEL CONTROL (for SFX):
    # Reserve channel 2 for sound effects:
    music_disable_ch(2)          # Music won't touch channel 2

    # Play your SFX on channel 2 (direct SID writes)
    sfx_shoot()

    # Give channel back to music:
    music_enable_ch(2)

    # Starting a new song? Restore all channels:
    new_song_init()
    music_enable_all_ch()        # All 3 channels for music

    NOTE: The song should be composed to use only channels 0-1 when
    channel 2 is reserved for SFX. Otherwise, "holes" appear in the music.

FUNCTIONS:
    music_enable_loop()           - Enable looping (default)
    music_disable_loop()          - Disable looping (play once)
    music_is_ended() -> byte      - Check if music ended (1=yes, 0=no)
    music_disable_ch(ch)          - Disable channel for music (0, 1, or 2)
    music_enable_ch(ch)           - Re-enable channel for music
    music_enable_all_ch()         - Re-enable all channels
    music_set_volume(vol)         - Set master volume (0-15, default: 15)
    music_stop_fade(tenths)       - Stop with fade out (1-25 = 0.1-2.5 sec)
"""



@keep
@naked
def _musicplayer_driver():
    """Music player driver code. Called automatically when included."""
    __asm__("""

// ============================================================
// FEATURE FLAGS - Default to 0 (disabled) for automatic optimization
// Song files define flags for features they USE (set to 1)
// Include song BEFORE musicplayer!
// ============================================================
.if (!defined(USE_VIBRATO)) { .var USE_VIBRATO = 0 }
.if (!defined(USE_PORTAMENTO)) { .var USE_PORTAMENTO = 0 }
.if (!defined(USE_ARPEGGIO_EFFECT)) { .var USE_ARPEGGIO_EFFECT = 0 }
.if (!defined(USE_FILTER_EFFECT)) { .var USE_FILTER_EFFECT = 0 }
.if (!defined(USE_ARP_MACRO)) { .var USE_ARP_MACRO = 0 }
.if (!defined(USE_DUTY_MACRO)) { .var USE_DUTY_MACRO = 0 }
.if (!defined(USE_WAVE_MACRO)) { .var USE_WAVE_MACRO = 0 }
.if (!defined(USE_CUT_MACRO)) { .var USE_CUT_MACRO = 0 }
.if (!defined(USE_EX1_FILT_MODE)) { .var USE_EX1_FILT_MODE = 0 }
.if (!defined(USE_EX2_RESONANCE)) { .var USE_EX2_RESONANCE = 0 }
.if (!defined(USE_EX3_FILT_TOGGLE)) { .var USE_EX3_FILT_TOGGLE = 0 }
.if (!defined(USE_EX4_SPECIAL)) { .var USE_EX4_SPECIAL = 0 }

    // Jump over driver code
    jmp _mp_driver_end


// ============================================================
// furC64 DRIVER - Full Furnace music player
// Converted from CC65 to Kick Assembler syntax
// ============================================================

// Number of SID channels
.const CHNUM = 3

// SID chip base address
.const SID = $D400

// Zero page locations - using PyCo IRQ temp area ($1A-$1F)
// This allows safe calling from IRQ handlers
.label temp = $1a           // irq_tmp0: temp bytes 0-3
.label flags_temp = $1d     // irq_tmp3: same as temp+3
.label patzp = $1e          // irq_tmp4-5: pattern pointer (16-bit)
.label macroIns = patzp

// ============================================================
// SONG DATA POINTERS (set by song's init function)
// ============================================================

_song_ticks_init:   .word 0     // -> ticks_init (2 bytes: speed1, speed2)
_song_furnace_hz:   .word 0     // -> furnace_hz (1 byte)
_song_order_len:    .byte 0     // order list length (copied, not pointer)
_song_order0L:      .word 0     // -> order0L table
_song_order0H:      .word 0     // -> order0H table
_song_order1L:      .word 0     // -> order1L table
_song_order1H:      .word 0     // -> order1H table
_song_order2L:      .word 0     // -> order2L table
_song_order2H:      .word 0     // -> order2H table
_song_insFL:        .word 0     // -> insFL table (instrument flags lo)
_song_insFH:        .word 0     // -> insFH table (instrument flags hi)
_song_insAL:        .word 0     // -> insAL table (arpeggio lo)
_song_insAH:        .word 0     // -> insAH table (arpeggio hi)
_song_insDL:        .word 0     // -> insDL table (duty lo)
_song_insDH:        .word 0     // -> insDH table (duty hi)
_song_insWL:        .word 0     // -> insWL table (waveform lo)
_song_insWH:        .word 0     // -> insWH table (waveform hi)
_song_insCL:        .word 0     // -> insCL table (cutoff lo)
_song_insCH:        .word 0     // -> insCH table (cutoff hi)
_song_insAspeed:    .word 0     // -> insAspeed table
_song_insArel:      .word 0     // -> insArel table
_song_insDrel:      .word 0     // -> insDrel table
// ex1-ex4 SID macro pointers
_song_insFML:       .word 0     // -> insFM lo (filter mode)
_song_insFMH:       .word 0     // -> insFM hi
_song_insFMspeed:   .word 0     // -> insFMspeed table
_song_insFMrel:     .word 0     // -> insFMrel table
_song_insResL:      .word 0     // -> insRes lo (resonance)
_song_insResH:      .word 0     // -> insRes hi
_song_insResspeed:  .word 0     // -> insResspeed table
_song_insResrel:    .word 0     // -> insResrel table
_song_insFTL:       .word 0     // -> insFT lo (filter toggle)
_song_insFTH:       .word 0     // -> insFT hi
_song_insFTspeed:   .word 0     // -> insFTspeed table
_song_insFTrel:     .word 0     // -> insFTrel table
_song_insSPL:       .word 0     // -> insSP lo (special)
_song_insSPH:       .word 0     // -> insSP hi
_song_insSPspeed:   .word 0     // -> insSPspeed table
_song_insSPrel:     .word 0     // -> insSPrel table

// ============================================================
// PLAYER VARIABLES (BSS)
// ============================================================

_mp_vars:
mframeW:        .fill CHNUM, 0
doMacroW:       .fill CHNUM, 0
env_reset:      .fill CHNUM, 0
env_reset2:     .fill CHNUM, $ff
env_reset3:     .fill CHNUM, $ff
env_reset4:     .fill CHNUM, 0
fil_lo_n2:      .fill 1, 0
fil_hi_n2:      .fill 1, 0
fil_st2:        .fill 1, 0
legato:         .fill CHNUM, 0
test_reset:     .fill CHNUM, 8
note_tick:      .fill CHNUM, 4
dur:            .fill CHNUM, 1
vibrato_param:  .fill CHNUM, 0
vibrato_phase:  .fill CHNUM, 0
absfil:         .fill 1, 0
doMacroC:       .fill 1, 0
inst2:          .fill CHNUM, 0
mframeC:        .fill 1, 0
instF:          .fill 1, 0
wav:            .fill CHNUM, 0
hrframe:        .fill CHNUM, 4
hrc:            .fill CHNUM, 0
freq_lo1:       .fill CHNUM, 0
freq_lo2:       .fill CHNUM, 0
freq_hi1:       .fill CHNUM, 0
freq_hi2:       .fill CHNUM, 0
ad:             .fill CHNUM, 0
sr:             .fill CHNUM, 0
patseq:         .fill CHNUM*2, 0
duty_lo:        .fill CHNUM, 0
duty_hi:        .fill CHNUM, 0
nextpat:        .fill 1, 0
patind:         .fill 1, 0
jumppat:        .fill 1, 0
ch:             .fill 1, 0
chm:            .fill 1, 0
tick:           .fill 1, 0
ins:            .fill CHNUM, 0
inst1:          .fill CHNUM, 0
inst_prev:      .fill CHNUM, 0
mframeA:        .fill CHNUM, 0
mframeD:        .fill CHNUM, 0
doMacroA:       .fill CHNUM, 0
doMacroD:       .fill CHNUM, 0
// ex1-ex4 macro state
doMacroFM:      .fill CHNUM, 0  // Filter Mode enable
doMacroRes:     .fill CHNUM, 0  // Resonance enable
doMacroFT:      .fill CHNUM, 0  // Filter Toggle enable
doMacroSP:      .fill CHNUM, 0  // Special enable
mframeFM:       .fill CHNUM, 0  // Filter Mode frame
mframeRes:      .fill CHNUM, 0  // Resonance frame
mframeFT:       .fill CHNUM, 0  // Filter Toggle frame
mframeSP:       .fill CHNUM, 0  // Special frame
filtmode:       .fill 1, 0      // Current filter mode (LP/BP/HP/CH3OFF)
resval:         .fill 1, 0      // Current resonance value (0-15)
filtroute:      .fill CHNUM, 0  // Filter routing per channel
specialbits:    .fill CHNUM, 0  // Special bits per channel (gate/sync/ring/test)
arp:            .fill CHNUM, 0
absarp:         .fill CHNUM, 0
arpTick:        .fill CHNUM, 0
effects_temp:   .fill 2, 0
tick_speeds:    .fill 2, 0
tick_sel:       .fill 1, 0
slide_amt_lo:   .fill CHNUM, 0
slide_amt_hi:   .fill CHNUM, 0
slide_amt_sign: .fill CHNUM, 0
slide_buffer_lo:.fill CHNUM, 0
slide_buffer_hi:.fill CHNUM, 0
note_pitch_lo:  .fill CHNUM, 0
note_pitch_hi:  .fill CHNUM, 0
note_n:         .fill CHNUM, 0
note_dest:      .fill CHNUM, 0
finepitch:      .fill CHNUM, $80
cut_dur:        .fill CHNUM, $ff
pw_mod_lo:      .fill CHNUM, 0
pw_mod_hi:      .fill CHNUM, 0
abspw:          .fill CHNUM, 0
retrigger_pw:   .fill CHNUM, 0
retrigger_fil:  .fill 1, 0
triggered_fil:  .fill 1, 0
arpeff1:        .fill CHNUM, 0
arpeff2:        .fill CHNUM, 0
arpind:         .fill CHNUM, 0
vol:            .fill 1, $7f
res:            .fill 1, 0
fil_lo:         .fill 1, $ff
fil_hi:         .fill 1, $07
fil_lo_n:       .fill 1, $ff
fil_hi_n:       .fill 1, $07
base:           .fill 1, 0
chipnum:        .fill 1, 0
is_6581:        .fill 1, 0
has_played:     .fill CHNUM, 0
ntsc_converted: .fill 1, 0
init_mode:      .fill 1, 0      // 0=VIC (PAL/NTSC adaptive), 1=CIA (60Hz fixed)
loop_enabled:   .fill 1, 1      // 1=loop song, 0=play once and stop
music_state:    .fill 1, 0      // 0=playing, non-zero=stopped
channel_enabled:.fill 1, 7      // Bitmask: bit 0=CH0, bit 1=CH1, bit 2=CH2 (default: all enabled)
stop_at_pattern_end:.fill 1, 0      // 0=normal, 1=stop at next pattern boundary
master_volume:  .fill 1, 15     // Master volume limit (0-15, default: 15 = full)
fade_active:    .fill 1, 0      // 0=no fade, 1=fade in progress
fade_speed:     .fill 1, 0      // Frames per volume step
fade_counter:   .fill 1, 0      // Frame counter for fade
fade_saved_vol: .fill 1, 15     // Volume saved before fade started

// Channel bitmask lookup table for enable/disable
channel_bit_mask:
    .byte 1, 2, 4               // X=0→1, X=1→2, X=2→4

// Fade speed lookup tables: tenths of seconds (0-25) -> frames per volume step
// 60Hz table (CIA mode, or VIC+NTSC): frames_per_step = duration * 6 / 15
fade_speed_60hz:
    .byte 1, 1, 1, 1, 2, 2, 2, 3, 3, 4   // 0-9 tenths (0-0.9 sec)
    .byte 4, 4, 5, 5, 6, 6, 6, 7, 7, 8   // 10-19 tenths (1.0-1.9 sec)
    .byte 8, 8, 9, 9, 10, 10             // 20-25 tenths (2.0-2.5 sec)

// 50Hz table (VIC+PAL): frames_per_step = duration * 5 / 15
fade_speed_50hz:
    .byte 1, 1, 1, 1, 1, 2, 2, 2, 3, 3   // 0-9 tenths (0-0.9 sec)
    .byte 3, 4, 4, 4, 5, 5, 5, 6, 6, 6   // 10-19 tenths (1.0-1.9 sec)
    .byte 7, 7, 7, 8, 8, 8               // 20-25 tenths (2.0-2.5 sec)

// Alias for compat_hr=1 mode
.label inst_buffer = inst1

table_1_to_ff:
table_fil:
    .byte 0
    .fill 15, $ff

// ============================================================
// INITIALIZATION
// ============================================================

// CIA init - 60Hz fixed on all systems
// Use this when using CIA timer IRQ for music playback
_mp_init_cia:
    lda #1
    sta init_mode
    jmp _mp_init_entry

// VIC init - PAL/NTSC adaptive (50/60Hz depending on system)
// Use this when using VIC raster IRQ for music playback
_mp_init:
initaddr:
    lda #0
    sta init_mode

_mp_init_entry:
    // Reset fade state (but keep user-set volume)
    lda #0
    sta fade_active
    // Initialize chip state
    ldx #0
_ia_chip_loop:
    lda #$7f
    sta vol, x
    lda #$00
    sta res, x
    sta retrigger_fil, x
    sta triggered_fil, x
    lda #$ff
    sta fil_lo, x
    sta fil_lo_n, x
    lda #$07
    sta fil_hi, x
    sta fil_hi_n, x
    lda #0
    sta doMacroC, x
    sta absfil, x
    sta fil_lo_n2, x
    sta fil_hi_n2, x
    sta fil_st2, x
    sta mframeC, x
    sta has_played, x
    dex
    bpl _ia_chip_loop

    lda #0
    sta tick_sel

    // Load ticks_init via song pointer
    lda _song_ticks_init
    sta temp
    lda _song_ticks_init+1
    sta temp+1
    ldy #0
    lda (temp), y
    sta tick_speeds
    iny
    lda (temp), y
    sta tick_speeds+1

    // PAL/NTSC detection
    lda #$ff
_ia_wait_255:
    cmp $d012
    bne _ia_wait_255
    ldx #200
_ia_wait_loop:
    dex
    bne _ia_wait_loop
    bit $d011
    bmi _ia_is_pal

    // NTSC detected - convert PAL frequency table to NTSC at runtime
    // Formula: freq_ntsc = freq_pal * 247 / 256 (PAL_CLOCK/NTSC_CLOCK ≈ 0.9634)
    // This saves 192 bytes compared to storing a separate NTSC table
    lda ntsc_converted
    bne _ia_ntsc_done

    ldx #95
_ia_ntsc_loop:
    // Convert PAL freq to NTSC using: freq_ntsc = freq - (freq × 9) / 256
    // This is equivalent to freq × 247 / 256 but avoids 16-bit overflow

    // Load freq into temp:temp+1, save copy in temp+3:patzp+1
    lda note_table_lo, x
    sta temp
    sta temp+3          // Save original freq_lo
    lda note_table_hi, x
    sta temp+1
    sta patzp+1         // Save original freq_hi
    lda #0
    sta temp+2          // Clear high byte for 24-bit result

    // Compute freq × 8 (shift left 3) as 24-bit value
    asl temp
    rol temp+1
    rol temp+2
    asl temp
    rol temp+1
    rol temp+2
    asl temp
    rol temp+1
    rol temp+2
    // temp:temp+1:temp+2 = freq × 8 (24-bit, no overflow)

    // Add original freq to get freq × 9
    clc
    lda temp
    adc temp+3
    sta temp
    lda temp+1
    adc patzp+1
    sta temp+1
    lda temp+2
    adc #0
    sta temp+2
    // temp:temp+1:temp+2 = freq × 9 (24-bit)

    // Divide by 256: (freq × 9) >> 8 = temp+1:temp+2
    // Subtract from original freq to get freq × 247 / 256
    sec
    lda temp+3          // Original freq_lo
    sbc temp+1          // Subtract (freq×9)>>8 low byte
    sta note_table_lo, x
    lda patzp+1         // Original freq_hi
    sbc temp+2          // Subtract (freq×9)>>8 high byte
    sta note_table_hi, x

    dex
    bpl _ia_ntsc_loop

    lda #1
    sta ntsc_converted

_ia_ntsc_done:
    // Check if CIA mode - skip VIC-specific speed adjustment
    lda init_mode
    bne _ia_cia_speed

    // VIC mode: Load furnace_hz via song pointer
    lda _song_furnace_hz
    sta temp
    lda _song_furnace_hz+1
    sta temp+1
    ldy #0
    lda (temp), y
    cmp #60
    beq _ia_speed_done
    // VIC+NTSC: Furnace=50Hz, NTSC=60Hz: speed * 1.2
    lda tick_speeds
    sta temp
    lsr
    lsr
    clc
    adc temp
    sta tick_speeds
    lda tick_speeds+1
    sta temp
    lsr
    lsr
    clc
    adc temp
    sta tick_speeds+1
    jmp _ia_speed_done

_ia_is_pal:
    // Check if CIA mode - skip VIC-specific speed adjustment
    lda init_mode
    bne _ia_cia_speed

    // VIC mode: Load furnace_hz via song pointer
    lda _song_furnace_hz
    sta temp
    lda _song_furnace_hz+1
    sta temp+1
    ldy #0
    lda (temp), y
    cmp #50
    beq _ia_speed_done
    // Furnace=60Hz, PAL=50Hz: speed * 5/6
    // Load ticks_init[0] via song pointer
    lda _song_ticks_init
    sta temp
    lda _song_ticks_init+1
    sta temp+1
    lda (temp), y       // y=0, ticks_init[0]
    sta temp+2          // save for later add
    asl
    asl
    clc
    adc temp+2
    ldx #0
    sec
_ia_div6_loop:
    cmp #6
    bcc _ia_div6_done
    sbc #6
    inx
    jmp _ia_div6_loop
_ia_div6_done:
    stx tick_speeds
    // Load ticks_init[1] via song pointer (temp still points there)
    ldy #1
    lda (temp), y       // ticks_init[1]
    sta temp+2          // save for later add
    asl
    asl
    clc
    adc temp+2
    ldx #0
    sec
_ia_div6_loop2:
    cmp #6
    bcc _ia_div6_done2
    sbc #6
    inx
    jmp _ia_div6_loop2
_ia_div6_done2:
    stx tick_speeds+1
    jmp _ia_speed_done

// CIA mode: 60Hz fixed - adjust speed only based on furnace_hz
_ia_cia_speed:
    // CIA always runs at 60Hz, so:
    // - If furnace_hz=60: no adjustment needed (60=60)
    // - If furnace_hz=50: speed *= 1.2 (60/50)
    lda _song_furnace_hz
    sta temp
    lda _song_furnace_hz+1
    sta temp+1
    ldy #0
    lda (temp), y
    cmp #50
    bne _ia_speed_done
    // Furnace=50Hz, CIA=60Hz: speed * 1.2
    lda tick_speeds
    sta temp
    lsr
    lsr
    clc
    adc temp
    sta tick_speeds
    lda tick_speeds+1
    sta temp
    lsr
    lsr
    clc
    adc temp
    sta tick_speeds+1

_ia_speed_done:
    // 6581/8580 detection
    lda #0
    sta is_6581
    ldx #$18
_ia_clear_sid:
    sta SID,x
    dex
    bpl _ia_clear_sid

    lda #$ff
    sta SID+$0f
    sta SID+$10
    lda #$51
    sta SID+$12

    ldx #0
    ldy #0
_ia_detect_loop:
    lda SID+$1b
    bpl _ia_not_high
    iny
_ia_not_high:
    inx
    bne _ia_detect_loop

    cpy #64
    bcs _ia_is_8580
    lda #1
    sta is_6581
    jmp _ia_detect_done
_ia_is_8580:
_ia_detect_done:
    lda #0
    sta SID+$12
    sta patind

    ldx #CHNUM-1
_ia_ch_loop:
    lda #$80
    sta finepitch, x
    lda #1
    sta dur, x
    lda #$ff
    sta cut_dur, x
    lda #0
    sta pw_mod_lo, x
    sta pw_mod_hi, x
    sta wav, x
    sta retrigger_pw, x
    sta abspw, x
    sta ins, x
    sta inst1, x
    sta inst_prev, x
    sta arp, x
    sta slide_amt_lo, x
    sta slide_amt_hi, x
    sta slide_amt_sign, x
    sta slide_buffer_lo, x
    sta slide_buffer_hi, x
    sta vibrato_phase, x
    sta vibrato_param, x
    sta note_dest, x
    sta mframeA, x
    sta mframeW, x
    sta mframeD, x
    sta mframeFM, x
    sta mframeRes, x
    sta mframeFT, x
    sta mframeSP, x
    sta doMacroA, x
    sta doMacroW, x
    sta doMacroD, x
    sta doMacroFM, x
    sta doMacroRes, x
    sta doMacroFT, x
    sta doMacroSP, x
    sta arpTick, x
    sta env_reset, x
    sta env_reset4, x
    lda #$ff
    sta env_reset2, x
    sta env_reset3, x
    lda #8
    sta test_reset, x
    lda #4
    sta hrframe, x
    sta note_tick, x
    dex
    bpl _ia_ch_loop

    ldx #0
    jsr set_patseq_init
    lda #0
    sta tick
    sta jumppat
    sta nextpat         // Clear pattern advance flag
    sta music_state     // Reset state to playing
    sta stop_at_pattern_end // Clear any pending stop-at-pattern request
    lda #1
    sta loop_enabled    // Default: loop enabled

    rts

// ============================================================
// STOP PLAYBACK
// ============================================================

_mp_stop:
    lda #1
    sta music_state     // Set stopped state
    lda #0
    sta fade_active     // Cancel any active fade
    lda fade_saved_vol
    sta master_volume   // Restore saved volume
_mp_stop_silence:
    // Silence all SID voices (entry point when music_state already set)
    lda #0
    sta SID+$04
    sta SID+$0B
    sta SID+$12
    // Keep master volume for SFX, just clear filter mode
    lda master_volume
    sta SID+$18
    rts

// ============================================================
// CONTINUE PLAYBACK
// ============================================================

_mp_continue:
    lda #0
    sta music_state     // Clear stopped state - playback resumes
    sta stop_at_pattern_end // Also clear any pending stop-after-pattern
    sta fade_active     // Cancel any active fade
    lda fade_saved_vol
    sta master_volume   // Restore saved volume
    rts

// ============================================================
// LOOP CONTROL
// ============================================================

// Set loop mode: A=0 (play once), A=1 (loop)
_mp_set_loop:
    sta loop_enabled
    rts

// ============================================================
// EFFECT HANDLERS
// ============================================================

effectE0:   // 09xx - Set speed 1
    jsr inc_patzp
    lda (patzp), y
    sta tick_speeds
    jmp begnote

effectE1:   // 0Fxx - Set speed 2
    jsr inc_patzp
    lda (patzp), y
    sta tick_speeds+1
    jmp begnote

effectE2:   // 00xx - Arpeggio
    jsr inc_patzp
    lda (patzp), y
    sta effects_temp+1
    ldx ch
    lda #0
    sta arpind, x
    lda effects_temp+1
    and #$0f
    sta arpeff2, x
    lda effects_temp+1
    lsr
    lsr
    lsr
    lsr
    sta arpeff1, x
    jmp begnote

effectE3:   // 01xx - Slide up
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta slide_amt_lo, x
    jsr inc_patzp
    lda (patzp), y
    sta slide_amt_hi, x
    lda #$ff
    sta slide_amt_sign, x
    lda #$ff
    sta note_dest, x
    jmp begnote

effectE4:   // 02xx - Slide down
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta slide_amt_lo, x
    jsr inc_patzp
    lda (patzp), y
    sta slide_amt_hi, x
    lda #$00
    sta slide_amt_sign, x
    lda #$ff
    sta note_dest, x
    jmp begnote

effectE5:   // 03xx - Portamento
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta slide_amt_lo, x
    jsr inc_patzp
    lda (patzp), y
    sta slide_amt_hi, x
    ldy #0
    jsr inc_patzp
    lda (patzp), y
    // X already = ch from line 776 (patzp ops don't change X)
    sta note_dest, x
    lda note_n, x
    cmp note_dest, x
    bne _e5_not_same
    lda #0
    sta slide_amt_lo, x
    sta slide_amt_hi, x
    sta slide_amt_sign, x
    jmp begnote
_e5_not_same:
    bcc _e5_slide_up
    lda #$00
    sta slide_amt_sign, x
    jmp begnote
_e5_slide_up:
    lda #$ff
    sta slide_amt_sign, x
    jmp begnote

effectE6:   // 04xx - Vibrato
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta vibrato_param, x
    beq _e6_done
    sta vibrato_phase, x
_e6_done:
    jmp begnote

effectE7:   // 1Bxx - Filter retrigger
    jsr inc_patzp
    lda (patzp), y
    sta effects_temp+1
    and #$0f
    tax
    lda table_fil, x
    ldx ch
    beq _e7_no_reset
    ldx chipnum
    lda fil_lo_n, x
    sta fil_lo, x
    lda fil_hi_n, x
    sta fil_hi, x
    ldx ch
_e7_no_reset:
    lda effects_temp+1
    lsr
    lsr
    lsr
    lsr
    tax
    lda table_fil, x
    ldx chipnum
    sta retrigger_fil, x
    jmp begnote

effectE8:   // 1Cxx - PWM retrigger
    jsr inc_patzp
    lda (patzp), y
    sta effects_temp+1
    and #$0f
    tax
    lda table_fil, x
    ldx ch
    beq _e8_no_reset
    lda #0
    sta pw_mod_lo, x
    sta pw_mod_hi, x
_e8_no_reset:
    lda effects_temp+1
    lsr
    lsr
    lsr
    lsr
    tax
    lda table_fil, x
    ldx ch
    sta retrigger_pw, x
    jmp begnote

effectE9:   // E1xx - Relative slide up
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    asl
    asl
    sta slide_amt_lo, x
    lda #$00
    sta slide_amt_hi, x
    lda #$ff
    sta slide_amt_sign, x
    ldy #0
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    ora #$80
    sta note_dest, x
    jmp begnote

effectEA:   // E2xx - Relative slide down
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    asl
    asl
    sta slide_amt_lo, x
    lda #$00
    sta slide_amt_hi, x
    sta slide_amt_sign, x
    ldy #0
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    ora #$80
    sta note_dest, x
    jmp begnote

effectEB:   // E5xx - Fine pitch
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta finepitch, x
    jmp begnote

effectEC:   // ECxx - Note cut
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    clc
    adc #2      // compat_hr=1
    sta cut_dur, x
    jmp begnote

effectED:   // 0Bxx - Jump to pattern
    jsr inc_patzp
    lda (patzp), y
    sta patind
    lda #$ff
    sta jumppat
    jmp begnote

effectEE:   // 4xxx - Filter cutoff
    ldx chipnum
    lda #0
    sta doMacroC, x
    sta fil_hi_n2, x
    lda #$ff
    sta fil_st2, x
    jsr inc_patzp
    lda (patzp), y
    ldx chipnum
    sta fil_lo_n2, x
    clc
    asl fil_lo_n2, x
    rol fil_hi_n2, x
    clc
    asl fil_lo_n2, x
    rol fil_hi_n2, x
    clc
    asl fil_lo_n2, x
    rol fil_hi_n2, x
    jmp begnote

effectEF:   // EAxx - Legato off
    ldx ch
    lda #0
    sta legato, x
    jmp begnote

effectF0:   // EAxx - Legato on
    ldx ch
    lda #$ff
    sta legato, x
    jmp begnote

effectF1:   // 1Axx - Envelope reset timing
    jsr inc_patzp
    lda (patzp), y
    ldx ch
    sta env_reset3, x
    jmp begnote

// Effect dispatch table
eff_lo:
    .byte <effectE0, <effectE1, <effectE2, <effectE3
    .byte <effectE4, <effectE5, <effectE6, <effectE7
    .byte <effectE8, <effectE9, <effectEA, <effectEB
    .byte <effectEC, <effectED, <effectEE, <effectEF
    .byte <effectF0, <effectF1
eff_hi:
    .byte >effectE0, >effectE1, >effectE2, >effectE3
    .byte >effectE4, >effectE5, >effectE6, >effectE7
    .byte >effectE8, >effectE9, >effectEA, >effectEB
    .byte >effectEC, >effectED, >effectEE, >effectEF
    .byte >effectF0, >effectF1

// ============================================================
// OTHER EFFECTS HANDLER
// ============================================================

other_effects:
    lda effects_temp
    cmp #$FB
    bne _oe_not_fb
    ldx ch
    jsr inc_patzp
    lda (patzp), y
    sta ins, x
    jmp begnote
_oe_not_fb:
    cmp #$FC
    bne _oe_not_fc
    ldx chipnum
    jsr inc_patzp
    lda vol
    and #$f0
    ora (patzp), y
    sta vol, x
    jmp begnote
_oe_not_fc:
    cmp #$FD
    bne _oe_not_fd
    ldx ch
    ldy ins, x
    sty temp+3          // save instrument index
    // Load insArel[y] via pointer
    lda _song_insArel
    sta temp
    lda _song_insArel+1
    sta temp+1
    lda (temp), y
    sta mframeA, x
    lda #0
    sta arpTick, x
    // Load insDrel[y] via pointer
    ldy temp+3          // restore instrument index
    lda _song_insDrel
    sta temp
    lda _song_insDrel+1
    sta temp+1
    lda (temp), y
    sta mframeD, x
    ldx ch
    lda wav, x
    and #%11111110
    sta wav, x
    lda #1
    ldx ch
    sta dur, x
    ldy #0
    jmp end_advance
_oe_not_fd:
    cmp #$FE
    bne _oe_not_fe
    ldx ch
    lda wav, x
    and #%11111110
    sta wav, x
    lda #1
    ldx ch
    sta dur, x
    ldy #0
    jmp end_advance
_oe_not_fe:
    lda effects_temp
    cmp #224
    bcc cont_advance
    lda effects_temp
    and #$1f
    tax
    lda eff_lo, x
    sta _effect_smc+1
    lda eff_hi, x
    sta _effect_smc+2
    ldx ch
    lda effects_temp
_effect_smc:
    jmp cont_advance

// ============================================================
// ADVANCE PATTERN ROUTINE
// ============================================================

advance:
_adv_beg:
    lda ch
    asl
    tax
    lda patseq, x
    sta patzp
    lda patseq+1, x
    sta patzp+1

    ldx ch
    dec dur, x
    lda dur, x
    beq begnote
    jmp end_advance

begnote:
    ldy #0
    jsr inc_patzp
    lda (patzp), y
    sta temp
    sta effects_temp
    and #$80
    beq _adv_wait
    lda temp
    cmp #$ff
    beq _adv_blank2
    jmp other_effects

cont_advance:
    lda temp
    and #$7f
    ldx ch
    sta note_n, x

    lda note_tick, x
    cmp #2
    bcc _ca_skip_hr
    lda legato, x
    bne _ca_skip_hr
    lda #0
    sta hrframe, x
    lda #$ff
    sta hrc, x
_ca_skip_hr:
    lda #0
    sta slide_buffer_lo, x
    sta slide_buffer_hi, x
    sta note_tick, x
    // X already = ch from line 1151
    lda env_reset2, x
    sta env_reset, x
    lda env_reset3, x
    sta env_reset2, x
    lda #1
    sta dur, x
    sta has_played, x
    ldy #0
    jmp end_advance

_adv_wait:
    lda temp
    and #$40
    beq _aw_not_ins
    ldx ch
    lda temp
    and #$3f
    sta ins, x
    jmp begnote
_aw_not_ins:
    lda temp
    ldx ch
    sta dur, x
_adv_blank2:
    lda temp
    cmp #$ff
    bne end_advance
    lda #$ff
    sta nextpat

end_advance:
    lda ch
    asl
    tax
    lda patzp
    sta patseq, x
    lda patzp+1
    sta patseq+1, x
    rts

// ============================================================
// INSTRUMENT ARPEGGIO MACRO (only if USE_ARP_MACRO is enabled)
// ============================================================
.if (USE_ARP_MACRO) {
insarp:
_ia_beg:
    ldx ch
    lda doMacroA, x
    bne _ia_enabled
    jmp _ia_end
_ia_enabled:
    // X already = ch from _ia_beg
    ldy inst_buffer, x
    inc arpTick, x
    // cmp insAspeed[y] via pointer
    sty temp+3          // save instrument index
    lda _song_insAspeed
    sta temp
    lda _song_insAspeed+1
    sta temp+1
    lda (temp), y       // A = insAspeed[inst]
    sta temp+2          // save for comparison
    lda arpTick, x
    cmp temp+2
    bcc _ia_checkspeed
    lda #0
    sta arpTick, x
    jmp _ia_doadvance

_ia_checkspeed:
    // Load insAL[y] -> macroIns via pointer (Y still has inst index)
    ldy temp+3          // restore instrument index
    lda _song_insAL
    sta temp
    lda _song_insAL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insAH[y] -> macroIns+1
    lda _song_insAH
    sta temp
    lda _song_insAH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeA, x
    lda (macroIns), y
    cmp #$fe
    bcs _ia_end
    sec
    sbc #128
    sta arp, x
    lda #0
    sta absarp, x
    rts

_ia_doadvance:
    // X already = ch from jmp at line 1236
    ldy inst_buffer, x
    // Load insAL[y] -> macroIns via pointer
    lda _song_insAL
    sta temp
    lda _song_insAL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insAH[y] -> macroIns+1
    lda _song_insAH
    sta temp
    lda _song_insAH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeA, x
    lda (macroIns), y
    cmp #$fe
    beq _ia_skip2
    cmp #$ff
    bne _ia_skip1
    iny
    lda (macroIns), y
    cmp #$ff
    beq _ia_stop
    sta mframeA, x
    jmp _ia_beg
_ia_stop:
    lda #0
    sta doMacroA, x
    rts
_ia_skip1:
    sec
    sbc #128
    sta arp, x
    lda #0
    sta absarp, x
    inc mframeA, x
    rts
_ia_skip2:
    iny
    lda (macroIns), y
    sta arp, x
    lda #$ff
    sta absarp, x
    inc mframeA, x
    inc mframeA, x
_ia_end:
    rts
}

// ============================================================
// INSTRUMENT DUTY MACRO (only if USE_DUTY_MACRO is enabled)
// ============================================================
.if (USE_DUTY_MACRO) {
insduty:
_id_beg:
    ldx ch
    lda doMacroD, x
    beq _id_end
    // X already = ch from _id_beg
    ldy inst_buffer, x
    // Load insDL[y] -> macroIns via pointer
    lda _song_insDL
    sta temp
    lda _song_insDL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insDH[y] -> macroIns+1
    lda _song_insDH
    sta temp
    lda _song_insDH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    ldy mframeD, x
    lda (macroIns), y
    sta temp
    cmp #$ff
    bne _id_skip1
    iny
    lda (macroIns), y
    cmp #$ff
    beq _id_stop
    sta mframeD, x
    jmp _id_beg
_id_stop:
    lda #0
    sta doMacroD, x
    rts
_id_skip1:
    iny
    lda (macroIns), y
    sta temp+1
    lda abspw, x
    bne _id_abs
    lda temp+1
    sec
    sbc #$80
    sta temp+1
    lda pw_mod_lo, x
    clc
    adc temp
    sta pw_mod_lo, x
    lda pw_mod_hi, x
    adc temp+1
    sta pw_mod_hi, x
    inc mframeD, x
    inc mframeD, x
    rts
_id_abs:
    lda temp
    sta duty_lo, x
    lda temp+1
    sta duty_hi, x
    lda #0
    sta pw_mod_lo, x
    sta pw_mod_hi, x
    inc mframeD, x
    inc mframeD, x
_id_end:
    rts
}

// ============================================================
// INSTRUMENT WAVE MACRO (only if USE_WAVE_MACRO is enabled)
// ============================================================
.if (USE_WAVE_MACRO) {
inswave:
_iw_beg:
    ldx ch
    lda doMacroW, x
    beq _iw_end
    // X already = ch from _iw_beg
    ldy inst_buffer, x
    // Load insWL[y] -> macroIns via pointer
    lda _song_insWL
    sta temp
    lda _song_insWL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insWH[y] -> macroIns+1
    lda _song_insWH
    sta temp
    lda _song_insWH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeW, x
    lda (macroIns), y
    cmp #$ff
    bne _iw_skip1
    iny
    lda (macroIns), y
    cmp #$ff
    beq _iw_stop
    sta mframeW, x
    jmp _iw_beg
_iw_stop:
    lda #0
    sta doMacroW, x
    rts
_iw_skip1:
    // X already = ch (from bne branch, X unchanged)
    pha
    lda wav, x
    and #$0f
    sta wav, x
    pla
    ora wav, x
    sta wav, x
    inc mframeW, x
_iw_end:
    rts
}

// ============================================================
// INSTRUMENT FILTER CUTOFF MACRO (only if USE_CUT_MACRO is enabled)
// ============================================================
.if (USE_CUT_MACRO) {
inscut:
_ic_beg:
    ldx ch
    lda doMacroC, x
    beq _ic_end
    // X already = ch from _ic_beg
    ldy instF, x
    // Load insCL[y] -> macroIns via pointer
    lda _song_insCL
    sta temp
    lda _song_insCL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insCH[y] -> macroIns+1
    lda _song_insCH
    sta temp
    lda _song_insCH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeC, x
    lda (macroIns), y
    sta temp
    cmp #$ff
    bne _ic_skip1
    iny
    lda (macroIns), y
    cmp #$ff
    beq _ic_stop
    sta mframeC, x
    jmp _ic_beg
_ic_stop:
    lda #0
    sta doMacroC, x
    rts
_ic_skip1:
    iny
    lda (macroIns), y
    sta temp+1
    lda absfil, x
    bne _ic_abs
    lda temp+1
    sec
    sbc #$80
    sta temp+1
    lda fil_lo, x
    clc
    adc temp
    sta fil_lo, x
    lda fil_hi, x
    adc temp+1
    sta fil_hi, x
    jmp _ic_inc
_ic_abs:
    lda temp
    sta fil_lo, x
    lda temp+1
    sta fil_hi, x
_ic_inc:
    inc mframeC, x
    inc mframeC, x
_ic_end:
    rts
}

// ============================================================
// ex1: FILTER MODE MACRO (only if USE_EX1_FILT_MODE is enabled)
// ============================================================
.if (USE_EX1_FILT_MODE) {
insfiltmode:
_ifm_beg:
    ldx ch
    lda doMacroFM, x
    beq _ifm_end
    // X already = ch from _ifm_beg
    ldy instF, x
    // Load insFML[y] -> macroIns
    lda _song_insFML
    sta temp
    lda _song_insFML+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insFMH[y] -> macroIns+1
    lda _song_insFMH
    sta temp
    lda _song_insFMH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeFM, x
    lda (macroIns), y
    cmp #$ff
    bne _ifm_val
    iny
    lda (macroIns), y
    cmp #$ff
    beq _ifm_stop
    sta mframeFM, x
    jmp _ifm_beg
_ifm_stop:
    lda #0
    sta doMacroFM, x
    rts
_ifm_val:
    sta filtmode
    inc mframeFM, x
_ifm_end:
    rts
}

// ============================================================
