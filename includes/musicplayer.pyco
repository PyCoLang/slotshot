}

// ============================================================
// ex3: FILTER TOGGLE MACRO (only if USE_EX3_FILT_TOGGLE is enabled)
// ============================================================
.if (USE_EX3_FILT_TOGGLE) {
insfilttoggle:
_ift_beg:
    ldx ch
