}

// ============================================================
// FINE PITCH / VIBRATO (only if USE_VIBRATO is enabled)
// ============================================================
.if (USE_VIBRATO) {
doFinepitch:
    lda vibrato_param, x
    lsr
    lsr
    lsr
    lsr
    clc
    adc vibrato_phase, x
    and #63
    sta vibrato_phase, x
    tay
    lda vibrato_param, x
    and #$0f
    ora triangle_lookup, y
    tay

    clc
    lda note_pitch_lo, x
    adc #$40
    sta temp
    lda note_pitch_hi, x
    adc #1
    sta temp+1

    sec
    lda temp
    sbc finepitch, x
    sta temp
    bcs _fp_no_dec
    dec temp+1
_fp_no_dec:

    lda tri_vibrato_lookup, y
    lsr
    clc
    adc tri_vibrato_lookup, y
    sta temp+2
    lda #0
    adc #0
    sta temp+3

    sec
    lda temp
    sbc temp+2
    sta temp
    lda temp+1
    sbc temp+3
    sta temp+1
    rts
}

// Simplified version when no vibrato (just copy note_pitch to temp)
.if (!USE_VIBRATO) {
doFinepitch:
    lda note_pitch_lo, x
    sta temp
    lda note_pitch_hi, x
    sta temp+1
    rts
}

// ============================================================
// CHANNEL PROCESSING (HR mode)
// ============================================================

do_ch_jsr:
    ldx ch
    lda env_reset4, x
    beq _dc_no_dec
    dec env_reset4, x
_dc_no_dec:
    lda hrc, x
    beq _dc_skipHR1

    lda #0
    sta hrc, x
    // HR_ADSR = 1
    lda env_reset, x
    beq _dc_no_reset
    lda #$00    // TEST_AD
    sta ad, x
    lda #$00    // TEST_SR
    sta sr, x
    lda wav, x
    and #254    // 255^1
    ora test_reset, x
    sta wav, x
    jmp _dc_hr1_done
_dc_no_reset:
    lda #1
    sta env_reset4, x
_dc_hr1_done:
    lda #0
    sta doMacroA, x
    sta doMacroD, x
    sta doMacroW, x

_dc_skipHR1:
    lda hrframe, x
    cmp #4
    bne _dc_not4
    jmp _dc_skipHR2
_dc_not4:
    inc hrframe, x
    // compat_hr = 1
    cmp #1
    beq _dc_do_hr2
    jmp _dc_skipHR2
_dc_do_hr2:
    // X already = ch (from beq branch at _dc_not4)
    lda #0
    sta mframeA, x
    sta mframeD, x
    sta mframeW, x
    sta mframeFM, x
    sta mframeRes, x
    sta mframeFT, x
    sta mframeSP, x
    sta arpTick, x
    lda #$ff
    sta doMacroA, x
    sta doMacroD, x
    sta doMacroW, x
    sta doMacroFM, x
    sta doMacroRes, x
    sta doMacroFT, x
    sta doMacroSP, x

    lda inst_buffer, x
    tay                     // Y = instrument index
    // Load insFL[y] via song pointer
    lda _song_insFL
    sta temp
    lda _song_insFL+1
    sta temp+1
    lda (temp), y
    sta patzp
    // Load insFH[y] via song pointer
    lda _song_insFH
    sta temp
    lda _song_insFH+1
    sta temp+1
    lda (temp), y
    sta patzp+1

    // X already = ch (pointer loads don't change X)
    ldy #1
    lda (patzp), y
    sta ad, x
    iny
    lda (patzp), y
    sta sr, x

    iny
    lda (patzp), y
    sta duty_lo, x
    iny
    lda (patzp), y
    sta duty_hi, x

    iny
    lda (patzp), y
    sta flags_temp
    and #1
    sta abspw, x

    lda flags_temp
    and #2
    beq _dc_no_pw_reset
    lda #0
    sta pw_mod_lo, x
    sta pw_mod_hi, x
_dc_no_pw_reset:

    lda flags_temp
    and #4
    tay
    ldx chipnum
    lda res, x
    ldx chm
    and ch_filter_enable_inv, x
    cpy #0
    beq _dc_no_filter
    ora ch_filter_enable, x
_dc_no_filter:
    ldx chipnum
    sta res, x

    lda flags_temp
    and #8
    beq _dc_no_init_filter
    ldx chipnum
    lda #0
    sta doMacroC, x
    lda res, x
    and #$0f
    ldy #6
    ora (patzp), y
    sta res, x
    iny
    lda vol, x
    and #$0f
    ora (patzp), y
    sta vol, x
    iny
    lda (patzp), y
    sta fil_lo_n, x
    iny
    lda (patzp), y
    sta fil_hi_n, x

    lda flags_temp
    and #32
    bne _dc_skip_filter_copy
    lda triggered_fil, x
    beq _dc_do_filter_copy
    lda retrigger_fil, x
    beq _dc_skip_filter_copy
_dc_do_filter_copy:
    lda #$ff
    sta triggered_fil, x
    lda fil_lo_n, x
    sta fil_lo, x
    lda fil_hi_n, x
    sta fil_hi, x
_dc_skip_filter_copy:

    ldx ch
    lda inst_buffer, x
    cmp inst_prev, x
    beq _dc_no_new_ins
    ldx chipnum
    lda fil_lo_n, x
    sta fil_lo, x
    lda fil_hi_n, x
    sta fil_hi, x
    ldx ch
    lda inst_buffer, x
    sta inst_prev, x
_dc_no_new_ins:
_dc_no_init_filter:

    lda flags_temp
    and #32
    beq _dc_no_cut_macro
    ldx ch
    lda inst_buffer, x
    ldx chipnum
    sta instF, x
    lda #0
    sta mframeC, x
    lda #$ff
    sta doMacroC, x

    lda flags_temp
    and #16
    lsr
    tay
    lda table_1_to_ff, y
    ldy chipnum
    sta absfil, y
_dc_no_cut_macro:

    lda flags_temp
    and #64
    lsr
    lsr
    lsr
    ldx ch
    sta test_reset, x

    lda retrigger_pw, x
    beq _dc_no_pw_retrig
    lda #0
    sta pw_mod_lo, x
    sta pw_mod_hi, x
_dc_no_pw_retrig:

    lda mframeW, x
    beq _dc_no_wave_override
    ldy #0
    lda (patzp), y
    and #$0f
    sta temp
    lda wav, x
    and #%11110000
    ora #1
    ora temp
    sta wav, x
    jmp _dc_skipHR2
_dc_no_wave_override:
    // X already = ch (from beq branch, X unchanged since 1978)
    ldy #0
    lda (patzp), y
    ora #1
    sta wav, x

_dc_skipHR2:
    rts

// ============================================================
// MAIN PLAY ROUTINE
// ============================================================

_mp_play:
playaddr:
    // Check if music is stopped (paused or ended)
    lda music_state
    beq _mp_play_continue
    rts
_mp_play_continue:
    // Handle fade out (runs every frame, independent of tick)
    lda fade_active
    beq _mp_no_fade
    dec fade_counter
    bne _mp_no_fade
    // Counter reached 0, decrease volume
    lda fade_speed
    sta fade_counter          // Reset counter
    dec master_volume
    bpl _mp_no_fade           // If >= 0, continue playing
    // Volume reached 0, stop music completely
    // Use full _mp_stop to properly reset state (restores saved volume)
    jmp _mp_stop
_mp_no_fade:
    ldx tick_sel
    inc tick
    lda tick
    cmp tick_speeds, x
    bcs _pa_do_advance
    jmp skipseq
_pa_do_advance:
    lda #0
    sta tick

advance_tick:
    lda tick_sel
    eor #1
    sta tick_sel
    ldx #0
    lda #0
_pa_clear_fil:
    sta fil_st2, x
    dex
    bpl _pa_clear_fil

    // Process all 3 channels
    lda #0
    sta ch
    lda #0
    sta chipnum
    jsr advance

    lda #1
    sta ch
    lda #0
    sta chipnum
    jsr advance

    lda #2
    sta ch
    lda #0
    sta chipnum
    jsr advance

    lda nextpat
    beq skipnextpat
    lda #0
    sta nextpat
    lda jumppat
    beq _pa_not_jump
    lda #0
    sta jumppat
    jmp _pa_after_jump
_pa_not_jump:
    // Check if stop-at-pattern was requested
    lda stop_at_pattern_end
    beq _pa_no_stop_req
    // Stop requested: clear flag and stop playback
    lda #0
    sta stop_at_pattern_end
    jsr _mp_stop
    rts
_pa_no_stop_req:
    inc patind
    lda patind
    cmp _song_order_len
    bne _pa_after_jump
    // Song reached end - check if we should loop
    lda loop_enabled
    bne _pa_do_loop
    // No loop - stop playback (sets music_state=1)
    jsr _mp_stop
    rts
_pa_do_loop:
    lda #0
    sta patind
_pa_after_jump:
    jsr set_patseq
    ldx #CHNUM-1
    lda #1
durloop:
    sta dur, x
    dex
    bpl durloop
    jmp advance_tick

skipnextpat:
    lda jumppat
    beq skipseq
    lda #$ff
    sta nextpat

skipseq:
    // Channel 0
    ldx #0
    lda inst1, x
    sta inst2, x
    lda ins, x
    sta inst1, x
    lda #0
    sta ch
    sta chm
    sta base
    sta chipnum
    jsr do_ch_jsr

    // Channel 1
    ldx #1
    lda inst1, x
    sta inst2, x
    lda ins, x
    sta inst1, x
    lda #1
    sta ch
    sta chm
    lda #7
    sta base
    lda #0
    sta chipnum
    jsr do_ch_jsr

    // Channel 2
    ldx #2
    lda inst1, x
    sta inst2, x
    lda ins, x
    sta inst1, x
    lda #2
    sta ch
    sta chm
    lda #14
    sta base
    lda #0
    sta chipnum
    jsr do_ch_jsr

    // Instrument macros for all channels
    lda #0
    sta ch
.if (USE_ARP_MACRO) { jsr insarp }
.if (USE_WAVE_MACRO) { jsr inswave }
.if (USE_DUTY_MACRO) { jsr insduty }

    lda #1
    sta ch
.if (USE_ARP_MACRO) { jsr insarp }
.if (USE_WAVE_MACRO) { jsr inswave }
.if (USE_DUTY_MACRO) { jsr insduty }

    lda #2
    sta ch
.if (USE_ARP_MACRO) { jsr insarp }
.if (USE_WAVE_MACRO) { jsr inswave }
.if (USE_DUTY_MACRO) { jsr insduty }

    // Filter cutoff macro
    lda #0
    sta ch
.if (USE_CUT_MACRO) { jsr inscut }
    // ex1-ex4 macros (filter mode, resonance, filter toggle, special)
.if (USE_EX1_FILT_MODE) { jsr insfiltmode }
.if (USE_EX2_RESONANCE) { jsr insresonance }
.if (USE_EX3_FILT_TOGGLE) { jsr insfilttoggle }
.if (USE_EX4_SPECIAL) { jsr insspecial }
    ldx ch
    lda fil_st2, x
    beq _pa_no_fil2
    lda fil_lo_n2, x
    sta fil_lo, x
    lda fil_hi_n2, x
    sta fil_hi, x
_pa_no_fil2:

    // Note cut processing
    ldx #CHNUM-1
note_cut_loop:
    lda cut_dur, x
    cmp #$ff
    beq note_cut_loop_end
    dec cut_dur, x
    lda cut_dur, x
    beq _nc_do_cut
    jmp note_cut_loop_end
_nc_do_cut:
    lda #$ff
    sta cut_dur, x
    lda wav, x
    and #%11111110
    sta wav, x
note_cut_loop_end:
    dex
    bpl note_cut_loop

    // Relative slide destination calculation
    ldx #CHNUM-1
relslide_loop:
    lda note_dest, x
    and #$80
    beq slide_skip
    eor note_dest, x
    sta macroIns
    lda slide_amt_sign, x
    beq positive_slide2
    lda note_n, x
    clc
    adc macroIns
    jsr clamp_note
    sta note_dest, x
    jmp slide_skip
positive_slide2:
    lda note_n, x
    sec
    sbc macroIns
    jsr clamp_note
    sta note_dest, x
slide_skip:
    dex
    bpl relslide_loop

    // Calculate note pitches
    ldx #CHNUM-1
note_loop:
    jsr calc_ch_pitch
    dex
    bpl note_loop

    // Slide processing
    ldx #CHNUM-1
slide_loop:
    lda slide_amt_lo, x
    ora slide_amt_hi, x
    bne _sl_do_slide
    jmp slide_loop2
_sl_do_slide:
    // Scale slide amount
    ldy note_pitch_hi, x
    lda scale_table, y
    sta temp+2
    lda slide_amt_lo, x
    sta temp
    lda slide_amt_hi, x
    sta temp+1

    lda temp+2
    beq _sl_no_scale
    bpl _sl_scale_left
_sl_scale_right:
    eor #$ff
    clc
    adc #1
    tay
_sl_rloop:
    lsr temp+1
    ror temp
    dey
    bne _sl_rloop
    jmp _sl_no_scale
_sl_scale_left:
    tay
_sl_lloop:
    asl temp
    rol temp+1
    dey
    bne _sl_lloop
_sl_no_scale:

    lda slide_amt_sign, x
    bne positive_slide
    sec
    lda slide_buffer_lo, x
    sbc temp
    sta slide_buffer_lo, x
    lda slide_buffer_hi, x
    sbc temp+1
    sta slide_buffer_hi, x

    lda note_dest, x
    cmp #96
    bcs slide_loop2

    ldy note_dest, x
    lda note_table_lo, y
    sta patzp
    lda note_table_hi, y
    sta patzp+1
    lda note_pitch_lo, x
    sta temp
    lda note_pitch_hi, x
    sta temp+1
    // cmp16 patzp, temp
    lda patzp
    sec
    sbc temp
    lda patzp+1
    sbc temp+1
    bcc slide_loop2
    bcs finish_slide

positive_slide:
    clc
    lda slide_buffer_lo, x
    adc temp
    sta slide_buffer_lo, x
    lda slide_buffer_hi, x
    adc temp+1
    sta slide_buffer_hi, x
    jmp _sl_check_dest

finish_slide:
    lda note_dest, x
    sta note_n, x
    lda #0
    sta slide_buffer_lo, x
    sta slide_buffer_hi, x
    sta slide_amt_lo, x
    sta slide_amt_hi, x
    sta slide_amt_sign, x
    jmp slide_loop2

_sl_check_dest:
    lda note_dest, x
    cmp #96
    bcs slide_loop2
    ldy note_dest, x
    lda note_table_lo, y
    sta patzp
    lda note_table_hi, y
    sta patzp+1
    lda note_pitch_lo, x
    sta temp
    lda note_pitch_hi, x
    sta temp+1
    // cmp16 temp, patzp
    lda temp
    sec
    sbc patzp
    lda temp+1
    sbc patzp+1
    bcc slide_loop2
    bcs finish_slide

slide_loop2:
    dex
    bmi slide_loopt
    jmp slide_loop
slide_loopt:

    // Note tick update
    ldx #CHNUM-1
_nt_loop:
    lda note_tick, x
    cmp #96
    beq note_tick_loop
    inc note_tick, x
note_tick_loop:
    lda has_played, x
    bne note_tick_loop2
    lda #3
    sta note_tick, x
note_tick_loop2:
    dex
    bpl _nt_loop

    // Write volume + filter mode to $D418
    // vol already contains: bits 0-3 = volume, bits 4-7 = filter mode
    lda filtmode
    beq _so_no_fm
    // ex1 filter mode macro active - override filter mode bits
    asl
    asl
    asl
    asl             // shift to upper nibble
    sta temp
    lda vol
    and #$0f        // keep volume only
    ora temp        // add macro filter mode
    jmp _so_write_vol
_so_no_fm:
    // No ex1 macro - use vol as-is (includes instrument filter mode)
    lda vol
_so_write_vol:
    // A contains: bits 0-3 = volume, bits 4-7 = filter mode
    // Apply master volume limit
    tax                     // save full byte in X
    and #$0f                // extract volume
    cmp master_volume       // compare with master volume
    bcc _so_vol_ok          // if vol < master, keep it
    lda master_volume       // else use master volume
_so_vol_ok:
    sta temp                // save limited volume
    txa                     // get original byte
    and #$f0                // keep filter mode only
    ora temp                // add limited volume
    sta SID+$18

    // Write filter resonance + routing to $D417
    // res already contains: bits 0-2 = filter routing, bits 4-7 = resonance
    // Add filter toggle macro values if active (OR with existing routing)
    lda res
    ora filtroute+0
    ora filtroute+1
    ora filtroute+2
    sta temp
    // Check for ex2 resonance macro
    lda resval
    beq _so_no_res
    // ex2 resonance macro active - override resonance bits
    asl
    asl
    asl
    asl             // shift to upper nibble
    sta temp+1
    lda temp
    and #$0f        // keep routing only
    ora temp+1      // add macro resonance
    jmp _so_write_res
_so_no_res:
    // No ex2 macro - use temp as-is (includes instrument resonance)
    lda temp
_so_write_res:
    sta SID+$17

    // Write filter cutoff
    lda fil_lo
    sta temp
    lda fil_hi
    sta temp+1
    clc
    lsr temp+1
    ror temp
    clc
    lsr temp+1
    ror temp
    clc
    lsr temp+1
    ror temp
    lda temp
    ldy is_6581
    beq _fc_no_scale
    asl
    bcc _fc_no_scale
    lda #$ff
_fc_no_scale:
    sta SID+$16

    // Recalculate pitches for SID output
    ldx #CHNUM-1
note_loop3:
    jsr calc_ch_pitch
    dex
    bpl note_loop3

    // Write SID registers for enabled channels only
    ldx #2
_sid_loop:
    // Check if this channel is enabled (for SFX support)
    lda channel_enabled
    and channel_bit_mask, x
    beq _sid_skip_channel      // Skip if channel disabled

    txa
    pha
    tax
    jsr doFinepitch
    pla
    tax

    ldy ch_mul_tabl, x
    lda temp
    sta SID, y
    lda temp+1
    sta SID+1, y

    lda ad, x
    sta SID+5, y
    lda sr, x
    sta SID+6, y

    lda wav, x
    jsr fix_wav_6581
    sta SID+4, y
    lda duty_lo, x
    clc
    adc pw_mod_lo, x
    sta SID+2, y
    lda duty_hi, x
    adc pw_mod_hi, x
    and #$0f
    sta SID+3, y

_sid_skip_channel:
    dex
    bpl _sid_loop

    rts

// ============================================================
// HELPER ROUTINES
// ============================================================

set_patseq:
    stx temp+2
    // Fall through to set_patseq_init
set_patseq_init:
    // Uses song pointers for order tables
    // Y = patind (index into order tables)
    ldy patind

    // order0L[patind] -> patseq+0
    lda _song_order0L
    sta temp
    lda _song_order0L+1
    sta temp+1
    lda (temp), y
    sta patseq+0

    // order0H[patind] -> patseq+1
    lda _song_order0H
    sta temp
    lda _song_order0H+1
    sta temp+1
    lda (temp), y
    sta patseq+1

    // order1L[patind] -> patseq+2
    lda _song_order1L
    sta temp
    lda _song_order1L+1
    sta temp+1
    lda (temp), y
    sta patseq+2

    // order1H[patind] -> patseq+3
    lda _song_order1H
    sta temp
    lda _song_order1H+1
    sta temp+1
    lda (temp), y
    sta patseq+3

    // order2L[patind] -> patseq+4
    lda _song_order2L
    sta temp
    lda _song_order2L+1
    sta temp+1
    lda (temp), y
    sta patseq+4

    // order2H[patind] -> patseq+5
    lda _song_order2H
    sta temp
    lda _song_order2H+1
    sta temp+1
    lda (temp), y
    sta patseq+5

    ldx temp+2
    rts

add_arpeff:
    pha
    inc arpind, x
    ldy arpind, x
    lda arp_mod, y
    sta arpind, x
    tay
    pla
    cpy #1
    beq arp1
    cpy #2
    beq arp2
    rts
arp1:
    clc
    adc arpeff1, x
    rts
arp2:
    clc
    adc arpeff2, x
    rts

// Increment 16-bit pattern pointer
// Preserves: A, X, Y
inc_patzp:
    inc patzp
    bne !+
    inc patzp+1
!:  rts

// Calculate note pitch for channel X
// Input: X = channel (0-2)
// Output: note_pitch_lo[x], note_pitch_hi[x] updated
// Preserves: X
calc_ch_pitch:
    lda absarp, x
    beq _ccp_rel
    lda arp, x
    and #127
    jmp _ccp_out
_ccp_rel:
    lda note_n, x
    clc
    adc arp, x
_ccp_out:
    jsr add_arpeff
    jsr clamp_note
    tay
    clc
    lda note_table_lo, y
    adc slide_buffer_lo, x
    sta note_pitch_lo, x
    lda note_table_hi, y
    adc slide_buffer_hi, x
    sta note_pitch_hi, x
    rts

fix_wav_6581:
    // Fix waveform combinations that don't work on 6581
    // 6581 ANDs waveforms together → nearly silent for combinations
    // $30 (tri+saw) → $20 (saw)
    // $50 (tri+pulse) → $40 (pulse)
    // $60 (saw+pulse) → $40 (pulse)
    // $70 (tri+saw+pulse) → $40 (pulse)
    pha
    lda is_6581
    beq _fw_done
    pla
    pha
    and #$70                // Check tri+saw+pulse bits
    cmp #$30                // tri+saw? ($10+$20)
    beq _fw_remove_tri_30
    cmp #$50                // tri+pulse? ($10+$40)
    beq _fw_remove_tri_50
    cmp #$60                // saw+pulse? ($20+$40)
    beq _fw_remove_saw
    cmp #$70                // tri+saw+pulse? ($10+$20+$40)
    beq _fw_remove_saw_70
    // No problematic combination
    pla
    rts
_fw_remove_tri_30:
    pla
    and #$ef                // tri+saw → saw ($20) - richer harmonics
    rts
_fw_remove_tri_50:
    pla
    and #$4f                // tri+pulse → pulse ($40) - Duty controls timbre
    rts
_fw_remove_saw_70:
    pla
    and #$4f                // tri+saw+pulse → pulse ($40) - Duty controls timbre
    rts
_fw_remove_saw:
    pla
    and #$df                // saw+pulse → pulse ($40)
    rts
_fw_done:
    pla
    rts

arp_mod:
    .byte 0, 1, 2, 0

ch_mul_tabl:
    .byte 0, 7, 14

clamp_note:
    bcc _cn_ok
    lda #95
_cn_ok:
    rts

ch_filter_enable:
    .byte 1, 2, 4

ch_filter_enable_inv:
    .byte 254, 253, 251

// Vibrato lookup tables (only if USE_VIBRATO is enabled)
.if (USE_VIBRATO) {
// Triangle lookup for vibrato (64 bytes)
triangle_lookup:
    .byte $00, $08, $10, $18, $20, $28, $30, $38
    .byte $40, $48, $50, $58, $60, $68, $70, $78
    .byte $70, $68, $60, $58, $50, $48, $40, $38
    .byte $30, $28, $20, $18, $10, $08, $00, $08
    .byte $00, $08, $10, $18, $20, $28, $30, $38
    .byte $40, $48, $50, $58, $60, $68, $70, $78
    .byte $70, $68, $60, $58, $50, $48, $40, $38
    .byte $30, $28, $20, $18, $10, $08, $00, $00

// Vibrato lookup (256 bytes)
tri_vibrato_lookup:
    .byte $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80, $80
