// ============================================================
// ex4: SPECIAL MACRO (gate/sync/ring/test) - only if USE_EX4_SPECIAL is enabled
// ============================================================
.if (USE_EX4_SPECIAL) {
insspecial:
_isp_beg:
    ldx ch
    lda doMacroSP, x
    beq _isp_end
    // X already = ch from _isp_beg
    ldy instF, x
    // Load insSPL[y] -> macroIns
    lda _song_insSPL
    sta temp
    lda _song_insSPL+1
    sta temp+1
    lda (temp), y
    sta macroIns
    // Load insSPH[y] -> macroIns+1
    lda _song_insSPH
    sta temp
    lda _song_insSPH+1
    sta temp+1
    lda (temp), y
    sta macroIns+1
    // X already = ch (pointer loads don't change X)
    ldy mframeSP, x
    lda (macroIns), y
    cmp #$ff
    bne _isp_val
    iny
    lda (macroIns), y
    cmp #$ff
    beq _isp_stop
    sta mframeSP, x
    jmp _isp_beg
_isp_stop:
