@naked
def music_enable_loop():
    """Enable music looping (default behavior).

    When looping is enabled, the song will repeat forever.
    This is the default mode after music_init().
    """
    __asm__("""
    lda #1
    jmp _mp_set_loop
    """)


@naked
def music_disable_loop():
    """Disable music looping - play song only once.

    When looping is disabled, the music will stop after playing once
    and music_is_ended() will return 1.

    Call this AFTER initializing the song.
    """
    __asm__("""
    lda #0
    jmp _mp_set_loop
    """)


@naked
def music_tick():
    """Play one tick of music. Call this from your IRQ handler.

    This advances the music playback by one tick. Should be called
    at the song's tempo rate (typically 50Hz for PAL or 60Hz for CIA).
    """
    __asm__("""
    jmp _mp_play
    """)


@naked
def music_stop():
    """Stop music playback immediately and silence the SID.

    After stopping:
    - music_is_stopped() returns non-zero
    - music_tick() becomes a no-op (returns immediately)
    - Call music_continue() to resume, or music_init() to restart
    """
    __asm__("""
    jmp _mp_stop
    """)


@naked
def music_is_stopped() -> byte:
    """Check if music playback is stopped.

    Returns:
        Non-zero if music is stopped (paused or ended), 0 if playing

    Use this in your main loop to detect when music has been stopped.
    """
    __asm__("""
    lda music_state
    """)


@naked
def music_continue():
    """Continue music playback after stop.

    Resumes playback from where it was stopped.
    If music ended naturally, it stays at the end (silent).
    To restart from beginning, use music_init() instead.
    """
    __asm__("""
    jmp _mp_continue
    """)


@naked
def music_is_6581() -> byte:
    """Check if 6581 SID chip was detected.

    Returns:
        1 if 6581, 0 if 8580
    """
    __asm__("""
    lda is_6581
    """)


@naked
def music_disable_ch(ch: byte):
    """Disable music output on a channel, freeing it for SFX.

    Args:
        ch: Channel number (0, 1, or 2)

    After calling this, the music driver will NOT write to this channel's
    SID registers, allowing you to use it for sound effects.

    Example:
        music_disable_ch(2)        # Reserve channel 2 for SFX
        sfx_shoot()                # Play effect on channel 2
        music_enable_ch(2)         # Return channel to music
    """
    __asm__("""
    // A = channel (0-2)
    tax
    lda channel_bit_mask, x
    eor #$ff                      // Invert: bit to clear
    and channel_enabled           // Clear the bit
    sta channel_enabled
    """)


@naked
def music_enable_ch(ch: byte):
    """Re-enable music output on a channel.

    Args:
        ch: Channel number (0, 1, or 2)

    After calling this, the music driver will resume writing to this
    channel's SID registers. Call this when done with SFX.
    """
    __asm__("""
    // A = channel (0-2)
    tax
    lda channel_bit_mask, x
    ora channel_enabled           // Set the bit
    sta channel_enabled
    """)


@naked
def music_enable_all_ch():
    """Re-enable all channels for music playback.

    Call this after music_init() if you previously disabled channels
    and want to restore all of them for the new song.

    Example:
        music_disable_ch(2)        # Reserve channel 2 for SFX
        # ... play SFX ...
        new_song_init()            # Start new song
        music_enable_all_ch()      # Restore all channels
    """
    __asm__("""
    lda #7
    sta channel_enabled
    """)


@naked
def music_set_volume(vol: byte):
    """Set the master volume limit (0-15).

    Args:
        vol: Volume level (0 = silent, 15 = full volume)

    The music's volume will be limited to this value. If the song's
    volume is lower, it stays lower (preserving dynamics). If higher,
    it's capped at this limit.

    Example:
        music_set_volume(15)       # Full volume (default)
        music_set_volume(8)        # Half volume
        music_set_volume(0)        # Mute (but music keeps playing)
    """
    __asm__("""
    // A = volume (0-15)
    and #$0f                // Ensure 0-15 range
    sta master_volume
    sta fade_saved_vol      // Also update saved volume
    // If music stopped, update $D418 immediately (tick won't run)
    ldx music_state
    beq _msv_done           // If playing (0), tick will update $D418
    sta SID+$18             // If stopped, update now (filter mode = 0)
_msv_done:
    """)


@naked
def music_stop_fade(tenths: byte):
    """Stop music with a fade out effect.

    Args:
        tenths: Fade duration in tenths of a second (1-25).
                1 = 0.1 sec (very fast), 10 = 1 sec, 25 = 2.5 sec

    The volume will gradually decrease to 0, then the music stops.
    During fade, music_is_stopped() returns 0 (still playing).
    After fade completes, music_is_stopped() returns non-zero.

    Example:
        music_stop_fade(10)        # 1 second fade out
        music_stop_fade(5)         # 0.5 second fade out
    """
    __asm__("""
    // A = duration in tenths of a second (1-25)
    cmp #26
    bcc _msf_ok
    lda #25                   // Clamp to max 25
_msf_ok:
    tax
    // Select 50Hz or 60Hz table based on init_mode and PAL/NTSC
    // CIA mode (init_mode=1) → always 60Hz
    // VIC mode (init_mode=0) + NTSC (ntsc_converted=1) → 60Hz
    // VIC mode (init_mode=0) + PAL (ntsc_converted=0) → 50Hz
    lda init_mode
    bne _msf_60hz             // CIA mode → 60Hz
    lda ntsc_converted
    bne _msf_60hz             // NTSC → 60Hz
    // PAL 50Hz
    lda fade_speed_50hz, x
    jmp _msf_set
_msf_60hz:
    lda fade_speed_60hz, x
_msf_set:
    sta fade_speed
    sta fade_counter          // Initialize counter
    lda master_volume
    sta fade_saved_vol        // Save current volume before fade
    lda #1
    sta fade_active           // Start fade
    """)


@naked
def music_stop_pattern_end():
    """Request music to stop after the current pattern ends.

    Instead of stopping immediately, the music will continue playing
    until the current pattern ends, then stop gracefully.

    This creates smoother transitions in games where you want the music
    to fade out naturally rather than cut off mid-phrase.

    After stopping, you can:
    - Call music_continue() to resume from where it stopped
    - Call music_init() to restart from the beginning
    """
    __asm__("""
    lda #1
    sta stop_at_pattern_end
    """)
